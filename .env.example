# Nusxa oling: cp .env.example .env.local  (yoki: vercel env pull .env.local)
# Haqiqiy qiymatlarni hech qachon git'ga qo'shmang.

# Neon Postgres: pooled (ilova) va to'g'ridan-to'g'ri (Prisma CLI / migratsiya)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Admin paroli (production'da majburiy; lokalda bo'sh bo'lsa "admin123")
ADMIN_PASSWORD=""

# Vercel Blob — surat va musiqa yuklash
BLOB_READ_WRITE_TOKEN=""

# Telegram: operatorga yangi buyurtma xabarlari (bo'sh bo'lsa yuborilmaydi)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Yetim Blob fayllarini tozalash cron'i (Vercel shu qiymat bilan chaqiradi)
CRON_SECRET=""

# Saytning asosiy manzili
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
