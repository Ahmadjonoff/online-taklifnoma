# Vercel CLI standart holatda .gitignore'ni to'liq hurmat qilmaydi — shu
# sababli runtime uchun kerak bo'lmagan fayllar bu yerda alohida ko'rsatiladi.

# Mahalliy SQLite baza — production'ga hech qachon yuklanmasligi kerak.
*.db
*.db-journal
dev.db
prisma/dev.db

# Maxfiy qiymatlar — .vercelignore mavjud bo'lsa CLI .gitignore'ni
# ishlatmaydi, shuning uchun bu yerda ham aniq ko'rsatilishi SHART.
# Production qiymatlari Vercel Environment Variables'dan olinadi.
.env*

# Shablonlar Vercel build'ida `templates-src` + `scripts`dan qayta
# yig'iladi (package.json → vercel-build), tayyor natijani yuklamaymiz.
public/t
tsconfig.tsbuildinfo

# Faqat lokal ishlab chiqish/hujjatlar uchun, deploy uchun kerak emas.
docs
.agents
.claude
.windsurf
.freebuff
