generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7: ulanish manzillari bu yerda emas, `prisma7.config.ts`da
// (`datasource.url` / `datasource.directUrl`) beriladi — schema faylida
// `url`/`directUrl` endi qo'llab-quvvatlanmaydi.
datasource db {
  provider = "postgresql"
}

model EventType {
  id                Int        @id @default(autoincrement())
  slug              String     @unique // "toy", "nikoh", "sunnat-toyi", "tugilgan-kun"
  name              String // "To'y", "Nikoh to'yi", ...
  emoji             String     @default("🎉")
  order             Int        @default(0)
  templates         Template[]
  // Katalogda shu tadbir turi ostida ko'rinadigan shablonlar (asosiy turi
  // boshqa bo'lsa ham) — bitta dizayn bir nechta tadbirga mos keladi.
  categoryTemplates Template[] @relation("TemplateCategories")
}

model Template {
  id           Int          @id @default(autoincrement())
  slug         String       @unique // "royal-gold", "pastel-gul"
  name         String
  eventTypeId  Int
  eventType    EventType    @relation(fields: [eventTypeId], references: [id])
  description  String       @default("")
  price        Int          @default(0) // so'mda
  theme        String       @default("gold") // kanonik shablon nomi (public/t/<theme>)
  previewEmoji String       @default("💍")
  kicker       String       @default("") // hero ustidagi kichik yozuv
  timeline     String       @default("[]") // JSON: [{time, label}]
  notes        String       @default("[]") // JSON: [{title, text}]
  isActive     Boolean      @default(true)
  // Katalog filtri uchun: shablon ko'rinadigan barcha tadbir turlari
  // (asosiy `eventType` ham shu ro'yxatda bo'ladi)
  categories   EventType[]  @relation("TemplateCategories")
  orders       Order[]
  invitations  Invitation[]
  createdAt    DateTime     @default(now())
}

model Order {
  id           Int         @id @default(autoincrement())
  // Buyurtma holati sahifasi (`/buyurtma/[token]`) shu tasodifiy tokenga
  // qarab qidiradi — ketma-ket `id` orqali emas. Aks holda `id`ni sanab,
  // boshqa mijozlarning buyurtma holati va (to'langan bo'lsa) taklifnoma
  // havolasini har kim ko'ra olardi.
  accessToken  String      @unique @default(cuid())
  customerName String
  phone        String
  templateId   Int
  template     Template    @relation(fields: [templateId], references: [id])
  status       String      @default("PENDING") // PENDING | PAID | REJECTED
  // Buyurtma paytidagi narx (shablon + qo'shimcha xizmatlar, so'mda). Keyin
  // shablon narxi o'zgarsa ham mijozga aytilgan summa o'zgarmaydi.
  // 0 — narxlar ochiq bo'lishidan oldingi buyurtmalar.
  price        Int         @default(0)
  // Demo/test buyurtma (Instagram namunalari) — admin statistikasi va daromadga kirmaydi
  isDemo       Boolean     @default(false)
  // Mijoz qayerdan kelgan: utm_source (instagram, telegram ...) yoki referrer domeni
  source       String      @default("")
  // Mijozning Telegram chat ID'si — u botga /start bosgach RSVP va tilaklar xabari shu yerga boradi
  notifyChatId String      @default("")
  invitation   Invitation?
  createdAt    DateTime    @default(now())
}

model Invitation {
  id           Int            @id @default(autoincrement())
  slug         String         @unique // "ali-va-dilnoza" -> /e/ali-va-dilnoza
  orderId      Int            @unique
  order        Order          @relation(fields: [orderId], references: [id])
  templateId   Int
  template     Template       @relation(fields: [templateId], references: [id])
  // Taklifnoma mazmuni
  title        String // "Ali va Dilnoza" yoki "Sunnat to'yi"
  partner1     String         @default("")
  partner2     String         @default("")
  eventDate    DateTime
  eventTime    String         @default("18:00")
  venueName    String
  venueAddress String         @default("")
  message      String         @default("") // taklifnomadagi matn
  // Mijoz tanlagan sozlamalar (rang, kun tartibi, xarita havolalari,
  // musiqa, dress-kod ...) — JSON. Tuzilishi va tekshiruvi:
  // src/lib/customization.ts. Yangi sozlama qo'shish migratsiya talab qilmaydi.
  options      String         @default("{}")
  views        Int            @default(0)
  rsvps        RsvpResponse[]
  wishes       Wish[]
  guests       Guest[]
  createdAt    DateTime       @default(now())
}

model RsvpResponse {
  id           Int        @id @default(autoincrement())
  invitationId Int
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guestName    String
  attending    Boolean // true = kelaman, false = kelolmayman
  guestsCount  Int        @default(1)
  comment      String     @default("")
  // Shaxsiy havola orqali kelgan javob — qaysi mehmonga tegishli (Luxury)
  guestId      Int?
  guest        Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
}

model Wish {
  id           Int        @id @default(autoincrement())
  invitationId Int
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guestName    String
  message      String
  createdAt    DateTime   @default(now())
}

/// Shaxsiy mehmon havolasi (Luxury): /e/<slug>?g=<code> — taklifnoma
/// "Hurmatli <ism>!" deb ochiladi, mijoz kim ochgani va javob berganini ko'radi.
model Guest {
  id           Int            @id @default(autoincrement())
  invitationId Int
  invitation   Invitation     @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  name         String
  code         String         @unique
  views        Int            @default(0)
  openedAt     DateTime?
  rsvps        RsvpResponse[]
  createdAt    DateTime       @default(now())

  @@index([invitationId])
}
